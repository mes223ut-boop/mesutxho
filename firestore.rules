rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdminReader() {
      return isGoogleUser()
        && request.auth.token.email == 'mes223ut@gmail.com';
    }

    match /sessions/{sessionId} {
      allow get, list: if isAdminReader();
      allow write: if false;
    }

    match /loginSessions/{sessionId} {
      allow get, list: if isAdminReader();
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if isAdminReader()
        || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdminReader();
      allow write: if false;
    }

    match /bannedIPs/{ipHash} {
      allow get, list: if isAdminReader();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
